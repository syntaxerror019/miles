{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "curl -fsSL \"https://github.com/gohugoio/hugo/releases/download/v0.120.4/hugo_extended_0.120.4_linux-amd64.tar.gz\" | tar -xz && ./hugo",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)\\.(mp4|webm|webp|jpg|jpeg|png|gif|svg|pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
